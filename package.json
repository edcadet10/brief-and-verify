{
  "name": "brief-and-verify",
  "private": true,
  "version": "1.0.2",
  "description": "Free practice for making better decisions with any AI system.",
  "homepage": "https://edcadet10.github.io/brief-and-verify/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/edcadet10/brief-and-verify.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "lint:markdown": "markdownlint-cli2 README.md CONTRIBUTING.md SECURITY.md CODE_OF_CONDUCT.md SUPPORT.md GOVERNANCE.md CHANGELOG.md CONTENT_LICENSE.md docs/ARCHITECTURE.md .github/PULL_REQUEST_TEMPLATE.md",
    "test": "vitest run",
    "test:e2e:install": "playwright install chromium",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "preview": "vite preview",
    "check": "npm run lint -- --max-warnings=0 && npm run lint:markdown && npm test && npm run build"
  },
  "dependencies": {
    "lucide-react": "^1.33.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "@playwright/test": "^1.62.1",
    "axe-core": "^4.13.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "markdownlint-cli2": "^0.23.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
